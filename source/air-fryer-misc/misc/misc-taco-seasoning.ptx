<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="tac-season" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Taco Seasoning</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 tablespoons flour</cell>
    </row>
    <row>
      <cell>2 teaspoons chili powder</cell>
    </row>
    <row>
      <cell><m>1 \frac{1}{2}</m> teaspoons dried minced onion</cell>
    </row>
    <row>
    <cell><m>1 \frac{1}{4}</m> teaspoons salt</cell>
    </row>
    <row>
      <cell>1 teaspoon paprika</cell>
    </row>
    <row>
      <cell><m>\frac{3}{4}</m> teaspoon crushed beef bullion cube</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon sugar</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon cayenne pepper</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon garlic powder</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon onion powder (or to taste)</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Mix all ingredients together.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          Used in <xref ref="bean-enchilada">Black Bean Veggie Enchiladas</xref> and <xref ref="ench-cass">Enchilada Casserole</xref>
        </p>
      </li>
    </ul>
  </p>
</section>