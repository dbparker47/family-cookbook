<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="powd-sug-glaze" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Powdered Sugar Glaze</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>Confectioners' sugar, sifted</cell>
    </row>
    <row>
      <cell>Milk</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Gently warm milk in a small pot.
        </p>
      </li>
      <li>
        <p>
          Add sugar until glaze has the consistency you want.
        </p>
      </li>
      <li>
        <p>
          Drizzle over your dessert with a spoon.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          Used in <alert>Cinnamon Rolls (Grandma Joy)</alert>
        </p>
      </li>
    </ul>
  </p>
</section>