<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="bake-squash" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Baked Squash</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>Butternut Squash, each one halved lengthwise and seeded</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Place squash, cut sides down, on an aluminum foil-covered cookie sheet.
        </p>
      </li>
      <li>
        <p>
          Bake in oven at <m>375^\circ</m> for 40 minutes.  Squash should be tender and easily pierced with a fork.
        </p>
      </li>
      <li>
        <p>
          Let cool, and scoop out flesh.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          Used in <xref ref="russell-sweet-pot">Senator Russell Potatoes</xref>, <xref ref="butt-sq-ris">Butternut Squash Risotto</xref>, <xref ref="butt-sw-gb-soup">Butternut Squash (or Sweet Potato) and Garbanzo Bean Soup</xref> <xref ref="cran-sq-pasta">Cranberry Squash Pasta Salad</xref>, and <xref ref="pump-pie">Squash Pie</xref>.
        </p>
      </li>
    </ul>
  </p>
</section>