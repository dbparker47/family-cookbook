<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="pop-top" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Popcorn Toppings</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell><term>Sweet and Salty (For 1/4 cup popcorn):</term></cell>
    </row>
    <row>
      <cell>1 tablespoon butter</cell>
    </row>
    <row>
      <cell>1 tablespoon honey</cell>
    </row>
    <row>
    <cell><m>\frac{1}{4}</m> teaspoon vanilla extract</cell>
    </row>
    <row>
      <cell>Salt to taste</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Melt butter; add other ingredients; and then combine, keeping warm while popcorn pops.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Ingredients
  </p>
  <tabular>
     <row>
      <cell><term>Cinnamon and Sugar (For 1/4 cup popcorn)</term></cell>
    </row>
    <row>
      <cell>3 tablespoons sugar</cell>
    </row>
    <row>
      <cell>1 tablespoon butter</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon cinnamon</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon vanilla extract</cell>
    </row>
    <row>
      <cell>Salt to taste</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Melt butter; add other ingredients; and then combine, keeping warm while popcorn pops.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>