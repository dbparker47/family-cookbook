<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="cream-cheese-frost" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Cream Cheese Frosting</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>3 ounces cream cheese</cell>
    </row>
    <row>
      <cell>4 tablespoons butter</cell>
    </row>
    <row>
      <cell><m>3 \frac{1}{2}</m> cups powdered sugar</cell>
    </row>
    <row>
    <cell>1 teaspoon vanilla</cell>
    </row>
    <row>
      <cell>Some milk (but not too much)</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Stir together ingredients in a bowl.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          Used in <alert>Grandma's Cinnamon Rolls (Joy)</alert>
        </p>
      </li>
    </ul>
  </p>
</section>