<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="russell-sweet-pot" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Senator Russell Butternut Squash (or Sweet Potatoes)</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell><term>Casserole:</term></cell>
    </row>
    <row>
      <cell>3 cups canned sweet potatoes or <xref ref="bake-squash">Baked Butternut Squash</xref>, mashed</cell>
    </row>
    <row>
      <cell>1 cup sugar</cell>
    </row>
    <row>
    <cell>2 eggs</cell>
    </row>
    <row>
      <cell>1 teaspoon vanilla</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup evaporated milk</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup butter, melted</cell>
    </row>
    <row>
      <cell><term>Topping:</term></cell>
    </row>
    <row>
      <cell>1 cup brown sugar</cell>
    </row>
    <row>
      <cell>1 cup pecans, chopped</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup flour</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup butter, partly melted</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Mix casserole ingredients with a mixer until smooth.  Pour into a buttered 9" x 13" baking dish.
        </p>
      </li>
      <li>
        <p>
          Mix topping ingredients by hand to form a crumb mixture. Sprinkle and pat on top of sweet potatoes.
        </p>
      </li>
      <li>
        <p>
          Bake at <m>350^\circ</m> for 30 minutes.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>