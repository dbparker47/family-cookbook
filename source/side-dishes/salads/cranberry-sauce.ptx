<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="cran-sauce" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Cranberry Sauce</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>12 ounces cranberries</cell>
    </row>
    <row>
      <cell>1 cup water or orange juice</cell>
    </row>
    <row>
      <cell>1 cup sugar</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Boil water.
        </p>
      </li>
      <li>
        <p>
          Add sugar, stirring in until dissolved.
        </p>
      </li>
      <li>
        <p>
          Add cranberries.  Bring to boil, then simmer with an open top for 10 minutes or until cranberries pop.
        </p>
      </li>
      <li>
        <p>
          Let cool to room temperature and thicken.  Refrigerate.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          Instead of putting in orange juice, I will put in a cup of water and some orange juice concentrate.  Works well.
        </p>
      </li>
    </ul>
  </p>
</section>