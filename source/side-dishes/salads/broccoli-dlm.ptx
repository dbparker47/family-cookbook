<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Broccoli Salad (Dorothy Lane Market)</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell><term>Salad:</term></cell>
    </row>
    <row>
      <cell>2 bunches broccoli, washed, trimmed, and cut into flowerettes</cell>
    </row>
    <row>
      <cell>1 cup raisins</cell>
    </row>
    <row>
    <cell><m>\frac{1}{2}</m> cup chopped onion</cell>
    </row>
    <row>
      <cell>10 to 15 slices bacon, cooked crisp, drained, and crumbled</cell>
    </row>
    <row>
      <cell><term>Dressing:</term></cell>
    </row>
    <row>
      <cell>1 cup mayonnaise</cell>
    </row>
    <row>
      <cell>2 tablespoons vinegar</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup sugar</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Toss together broccoli, raisins, onion, and bacon.
        </p>
      </li>
      <li>
        <p>
          Combine dressing ingredients and pour over salad.  Do not stir.
        </p>
      </li>
      <li>
        <p>
          Refrigerate, covered, overnight.  Mix well before serving.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>