<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="cran-sq-pasta" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Cranberry Squash Pasta Salad</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>5 cups bow-tie pasta</cell>
    </row>
    <row>
      <cell>4 cups <alert>Baked Butternut Squash</alert></cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> pound cooked sausage</cell>
    </row>
    <row>
    <cell>4 cups sliced mushrooms, sauteed</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup dried cranberries</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup chopped fresh sage</cell>
    </row>
    <row>
      <cell>2 tablespoons walnut oil</cell>
    </row>
    <row>
      <cell>1 tablespoon balsamic vinegar</cell>
    </row>
    <row>
      <cell>2 cloves garlic, finely minced</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon black pepper</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon red pepper flakes</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Boil pasta.
        </p>
      </li>
      <li>
        <p>
          Add squash, sausage, mushrooms, cranberries, and sage.
        </p>
      </li>
      <li>
        <p>
          Mix together oil, vinegar, garlic, pepper, and pepper flakes as a dressing.  Pour over pasta and toss.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>