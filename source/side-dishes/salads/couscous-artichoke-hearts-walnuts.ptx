<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="cous-art-wal" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Couscous with Artichoke Hearts and Walnuts</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 cup boiling water</cell>
    </row>
    <row>
      <cell><m>1 \frac{1}{2}</m> cup couscous (uncooked)</cell>
    </row>
    <row>
      <cell>1 tablespoon olive oil</cell>
    </row>
    <row>
    <cell>1 teaspoon salt</cell>
    </row>
    <row>
      <cell>14 ounces artichoke hearts, chopped</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup minced scallions</cell>
    </row>
    <row>
      <cell>1 large clove of garlic, minced</cell>
    </row>
    <row>
      <cell>1 cup chopped fresh parsley</cell>
    </row>
    <row>
      <cell>1 to 2 tablespoon chopped fresh dill</cell>
    </row>
    <row>
      <cell>1 tablespoon fresh chopped mint (or 1 teaspoon dried mint)</cell>
    </row>
    <row>
      <cell>3 tablesepoon olive oil</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> to 1 cup lemon juice (to taste)</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> chopped walnuts</cell>
    </row>
    <row>
      <cell>Goat cheese (optional)</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Put the couscous in a large heat proof bowl.  Add the boiling water, 1 tablespoon olive oil, and salt.  Let it sit for 5 minutes and then fluff with a fork.
        </p>
      </li>
      <li>
        <p>
          Mix in the artichoke hearts, scallions, garlic, parsley, mint and dill.
        </p>
      </li>
      <li>
        <p>
          Stir in the oil, lemon juice, and walnuts.  Top with goat cheese.
        </p>
      </li>
      <li>
        <p>
          Serve at room temperature or chilled.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>