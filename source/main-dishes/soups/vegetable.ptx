<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="veg-soup" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Vegetable Soup</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 tablespoons olive oil</cell>
    </row>
    <row>
      <cell>1 onion</cell>
    </row>
    <row>
      <cell>5 to 6 carrots</cell>
    </row>
    <row>
    <cell>3+ celery ribs</cell>
    </row>
    <row>
      <cell>1 teaspoon oregano</cell>
    </row>
    <row>
      <cell>1 teaspoon basil</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon thyme</cell>
    </row>
    <row>
      <cell>28 ounces diced tomatoes</cell>
    </row>
    <row>
      <cell>2 quarts stock</cell>
    </row>
    <row>
      <cell>Lots of vegetables (corn, green beans, lima beans, peas, potatoes, zucchini, etc.)</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Gently sautee onions, carrots, celery, and garlic.  Cook patiently.
        </p>
      </li>
      <li>
        <p>
          Add in broth and tomatoes.  Bring to a boil.  Bring down to simmer.
        </p>
      </li>
      <li>
        <p>
          Add in vegetables.  Simmer for 30 to 40 minutes.
        </p>
      </li>
      <li>
        <p>
          Put in pasta 20 minutes before end.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>