<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sp-pea" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Split Pea Soup</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell><m>\frac{1}{2}</m> pound sausage or ham</cell>
    </row>
    <row>
      <cell>1 pound split peas</cell>
    </row>
    <row>
      <cell>6+ cups water</cell>
    </row>
    <row>
    <cell>5 to 6 carrots</cell>
    </row>
    <row>
      <cell>1 large onion</cell>
    </row>
    <row>
      <cell>1 teaspoon dried parsley</cell>
    </row>
    <row>
      <cell>3+ ribs celery</cell>
    </row>
    <row>
      <cell>2 bay leaves</cell>
    </row>
    <row>
      <cell>Salt and pepper to taste</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cook carrots, celery, and onion patiently in a pot.
        </p>
      </li>
      <li>
        <p>
          Toss everything else into the pot.
        </p>
      </li>
      <li>
        <p>
          Bring to a boil.
        </p>
      </li>
      <li>
        <p>
          Simmer for 1.5 hours
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>