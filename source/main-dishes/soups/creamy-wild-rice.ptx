<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="creamy-wr" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Creamy Wild Rice Soup</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 cup finely chopped onion</cell>
    </row>
    <row>
      <cell>6 tablespoons butter</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup flour</cell>
    </row>
    <row>
    <cell>3 cups vegetable broth</cell>
    </row>
    <row>
      <cell>2 to 3 cups cooked wild rice</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup grated carrots</cell>
    </row>
    <row>
      <cell>3 tablespoons slivered almonds</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon salt</cell>
    </row>
    <row>
      <cell>1 cup half and half</cell>
    </row>
    <row>
      <cell>2 tablespoons dry sherry wine</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          In a Dutch oven, saute the onions in butter until they are soft.  Add flour, stirring constantly until bubbly.
        </p>
      </li>
      <li>
        <p>
          Slowly add the broth (it is easier to avoid lumps if the broth is hot).  Add the wild rice, carrots, almonds, and salt.  Cook for 10 to 15 minutes.
        </p>
      </li>
      <li>
        <p>
          Add the half and half and sherry.  Cook for another 10 minutes.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>