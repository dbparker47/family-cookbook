<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="chilled-avo" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Chilled Avocado Soup</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 medium ripe Haas avocado</cell>
    </row>
    <row>
      <cell>2 cups buttermilk</cell>
    </row>
    <row>
      <cell>2 tablespoons lemon juice</cell>
    </row>
    <row>
    <cell>1 medium tomato, seeded and diced</cell>
    </row>
    <row>
      <cell>1 scallion, thinly sliced</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon salt</cell>
    </row>
    <row>
      <cell>Cayenne pepper to taste</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cut avocado and remove flesh.
        </p>
      </li>
      <li>
        <p>
          Combine avocado, buttermilk, lemon juice, salt, and cayenne pepper in food processor or blender until smooth.  Pour into medium bowl.
        </p>
      </li>
      <li>
        <p>
          Set aside small amount (1 tablespoon?) of tomato and scallion, and stir the remaining tomato and scallion into soup.
        </p>
      </li>
      <li>
        <p>
          Cover and chill for 1 hour.  Top with tomato and scallion.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>