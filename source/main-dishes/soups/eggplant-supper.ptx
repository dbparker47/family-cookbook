<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="egg-supper" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Eggplant Supper Soup</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 tablespoons olive oil</cell>
    </row>
    <row>
      <cell>1 medium onion, chopped</cell>
    </row>
    <row>
      <cell>1 pound ground beef</cell>
    </row>
    <row>
    <cell>1 eggplant, peeled and diced</cell>
    </row>
    <row>
      <cell>1 clove garlic</cell>
    </row>
    <row>
      <cell>1 cup chopped carrots</cell>
    </row>
    <row>
      <cell>1 cup diced celery</cell>
    </row>
    <row>
      <cell>1 quart tomatoes</cell>
    </row>
    <row>
      <cell><m>3 \frac{1}{2}</m> cups beef broth</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon ground nutmeg</cell>
    </row>
    <row>
      <cell>1 teaspoon honey</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon pepper</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup barley</cell>
    </row>
    <row>
      <cell>1 tablespoon dried parsley</cell>
    </row>
    <row>
      <cell>Grated cheese</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cook onions, carrots, celery, and garlic patiently on the stove.  Add meat and cook.
        </p>
      </li>
      <li>
        <p>
          Drain fat and add eggplant, tomatoes, broth, nutmeg, honey, salt, and pepper.  Cover and simmer for 30 minutes.
        </p>
      </li>
      <li>
        <p>
          Add barley and simmer 30 minutes more.
        </p>
      </li>
      <li>
        <p>
          Serve soup in bowls and top with grated cheese.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>