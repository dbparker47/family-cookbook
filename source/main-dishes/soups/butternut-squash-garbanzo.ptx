<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="butt-sw-gb-soup" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Butternut Squash (or Sweet Potato) and Garbanzo Bean Soup</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 tablespoons olive oil</cell>
    </row>
    <row>
      <cell>1 large onion, chopped</cell>
    </row>
    <row>
      <cell>3 medium cloves garlic, minced</cell>
    </row>
    <row>
    <cell>1 stalk celery, minced</cell>
    </row>
    <row>
      <cell>2 medium squash (baked and scraped out) or 2 cups chopped sweet potatoes (1 can)</cell>
    </row>
    <row>
      <cell>1 teaspoon salt</cell>
    </row>
    <row>
      <cell>1 bay leaf</cell>
    </row>
    <row>
      <cell>2 teaspoons paprika</cell>
    </row>
    <row>
      <cell>1 teaspoon turmeric</cell>
    </row>
    <row>
      <cell>1 teaspoon basil</cell>
    </row>
    <row>
      <cell>Dash of cinnamon</cell>
    </row>
    <row>
      <cell>Dash of cayenne</cell>
    </row>
    <row>
      <cell>15 ounces canned tomato</cell>
    </row>
    <row>
      <cell>1 bell pepper, diced</cell>
    </row>
    <row>
      <cell>14 ounces garbanzo beans (<m>1 \frac{1}{2}</m> cup cooked)</cell>
    </row>
    <row>
      <cell>1 tablespoon soy sauce</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Heat the oil in a Dutch oven.  Add onion, garlic, celery, and squash, and saute for about 5 minutes. Add salt, and saute 5 minutes more.  Add bay leaf, seasonings, and water.  Cover, and simmer about 15 minutes.
        </p>
      </li>
      <li>
        <p>
          Add tomatoes, bell pepper, and garbanzo beans.  Cover and simmer for about 10 more minutes, or until all the vegetables are as tender as you like them.  Taste to adjust seasonings, and serve.  Add soy sauce before serving.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>