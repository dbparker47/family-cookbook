<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="w-rice-patt" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Wild Rice Patties (Parmesan)</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 cup cooked wild rice</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup chopped nuts (cashews, almonds, pecans, walnuts)</cell>
    </row>
    <row>
      <cell>2 tablespoons flour</cell>
    </row>
    <row>
    <cell>1 egg</cell>
    </row>
    <row>
      <cell>26 ounces pasta sauce</cell>
    </row>
    <row>
      <cell>1 pound mozzarella cheese, grated</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Mix ingredients together.
        </p>
      </li>
      <li>
        <p>
          Lightly grease a frying pan and heat to medium high
        </p>
      </li>
      <li>
        <p>
          With a spoon, place the mixture in the pan in 3 or 4 dollops and shape into patties.  The mixture will be loose at first, but will firm up with cooking.
        </p>
      </li>
      <li>
        <p>
          Pour pasta sauce over patties and cover with cheese.  Bake at <m>350^\circ</m> until cheese is melted.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>