<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="span-burr" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Burritos - Spanish Rice</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>12 flour tortillas</cell>
    </row>
    <row>
      <cell>14-ounce can of diced tomatoes</cell>
    </row>
    <row>
      <cell><m>1 \frac{1}{2}</m> cup brown rice</cell>
    </row>
    <row>
    <cell><m>2 \frac{1}{2}</m> cup water</cell>
    </row>
    <row>
      <cell>15-ounce can of black beans</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> pound ground beef (optional)</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup salsa</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon honey</cell>
    </row>
    <row>
      <cell>1 clove garlic, minced</cell>
    </row>
    <row>
      <cell><m>\frac{1}{8}</m> teaspoon pepper (optional)</cell>
    </row>
    <row>
      <cell>1 medium onion, chopped</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon dried oregano</cell>
    </row>
    <row>
      <cell>Cheddar cheese</cell>
    </row>
    <row>
      <cell>Plain yogurt or sour cream</cell>
    </row>
    <row>
      <cell>Green onions</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cook the onions, garlic, and meat in a small saute pan.  Set aside.
        </p>
      </li>
      <li>
        <p>
          Combine rice and water in a medium pot and cook covered for 20 minutes.
        </p>
      </li>
      <li>
        <p>
          Add the diced tomatoes, salt, pepper, and oregano.  Cook for about 15 minutes.
        </p>
      </li>
      <li>
        <p>
          Stir in the black beans, meat, onion, and garlic, and heat through.
        </p>
      </li>
      <li>
        <p>
          To serve, place some of the mixture on a tortilla and sprinkle cheese on it.  Top with green onions and yogurt.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          This also makes a great rice and beans meal.  Just leave out the tortillas.
        </p>
      </li>
    </ul>
  </p>
</section>