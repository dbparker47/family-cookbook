<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="art-pasta" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Artichoke Pasta</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>14 ounces artichoke hearts</cell>
    </row>
    <row>
      <cell>1 tablespoon olive oil</cell>
    </row>
    <row>
      <cell>1 tablespoon butter</cell>
    </row>
    <row>
    <cell>1 cup sliced onions</cell>
    </row>
    <row>
      <cell>1 tablespoon dried basil</cell>
    </row>
    <row>
      <cell>1 cup plain yogurt</cell>
    </row>
    <row>
      <cell>16 ounces cottage cheese</cell>
    </row>
    <row>
      <cell>2 pounds pasta (linguine or spaghetti)</cell>
    </row>
    <row>
      <cell>salt, pepper, cayenne, parmesan cheese - to taste</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Drain the artichoke hearts and cut them up into small pieces.
        </p>
      </li>
      <li>
        <p>
          Heat the olive oil and butter in a skillet.  Add the onions and saute them until soft.  Add the artichokes hearts and basil.  Saute 5 minutes more.
        </p>
      </li>
      <li>
        <p>
          Remove from heat.  Stir in the remaining ingredients. Cook and drain the pasta, and toss immediately with the still-warm sauce.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>