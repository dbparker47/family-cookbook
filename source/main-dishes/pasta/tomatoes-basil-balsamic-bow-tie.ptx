<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="balsamic-bowtie" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title></title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>Bow-tie pasta with tomatoes, basil, and balsamic vinegar</cell>
    </row>
    <row>
      <cell>1 pound bow-tie pasta</cell>
    </row>
    <row>
      <cell>1 clove garlic, minced</cell>
    </row>
    <row>
    <cell>1 package grape tomatoes, quartered</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup fresh basil (or 3 teaspoons dried basil)</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup fresh parsley (or 3 teaspoons dried parsley)</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon dried oregano</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> to <m>\frac{1}{2}</m> teaspoon crushed red pepper flakes (optional)</cell>
    </row>
    <row>
      <cell>2 tablespoons olive oil</cell>
    </row>
    <row>
      <cell>2 tablespoons lemon juice</cell>
    </row>
    <row>
      <cell>2 tablespoons balsamic vinegar</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cook the pasta in a large pot of boiling water until al dente.  Drain pasta.
        </p>
      </li>
      <li>
        <p>
          Meanwhile, combine the rest of the ingredients in a large pasta bowl.
        </p>
      </li>
      <li>
        <p>
          Add the pasta and serve immediately.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>