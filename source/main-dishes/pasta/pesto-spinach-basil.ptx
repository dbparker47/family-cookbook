<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sb-pesto" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Spinach Basil Pesto</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 cup olive oil</cell>
    </row>
    <row>
      <cell>1 jar sun-dried tomatoes (not sure how much that is)</cell>
    </row>
    <row>
      <cell>3 to 4 cloves garlic</cell>
    </row>
    <row>
    <cell>1 wedge feta cheese (not sure how much that is)</cell>
    </row>
    <row>
      <cell>Some chopped fresh basil (1 package)</cell>
    </row>
    <row>
      <cell>10 oz spinach, chopped</cell>
    </row>
    <row>
      <cell>1 to 2 red peppers, chopped</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> to <m>\frac{3}{4}</m> cup Parmesan cheese</cell>
    </row>
    <row>
      <cell><m>\frac{1}{3}</m> cup pine nuts, lightly toasted</cell>
    </row>
    <row>
      <cell>Fusilli pasta</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Mix ingredients (except pine nuts) in a bowl.  Let sit all day.  Stir occasionally.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>