<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="tag-tut-bene" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Tagliatelle (Tutto Bene)</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>12 pounds Italian sausage, cooked, chopped, and drained.</cell>
    </row>
    <row>
      <cell>4 ounces shitake mushrooms, sliced</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> pound oyster mushrooms, sliced</cell>
    </row>
    <row>
    <cell><m>\frac{1}{4}</m> pound fresh mushrooms, sliced</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> pound sun-dried tomatoes, soaked, drained, and chopped</cell>
    </row>
    <row>
      <cell>2 tablespoons butter</cell>
    </row>
    <row>
      <cell>2 to 3 cloves garlic, minced</cell>
    </row>
    <row>
      <cell>1 tablespoon parsley, minced</cell>
    </row>
    <row>
      <cell>2 pounds fettucine or tagliatelle noodles</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cook butter and mushrooms over medium heat until mushrooms begin to soften.
        </p>
      </li>
      <li>
        <p>
          Add garlic, parsley, sausage, and sun-dried tomatoes. Cook over medium heat, stirring frequently, until mushrooms are cooked.
        </p>
      </li>
      <li>
        <p>
          Cook and drain pasta.  Toss pasta in the pan with the remaining ingredients.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>