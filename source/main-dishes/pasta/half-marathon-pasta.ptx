<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="half-pasta" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Half-Marathon Pasta</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1+ pound chicken breast</cell>
    </row>
    <row>
      <cell>5 to 10 ounces spinach</cell>
    </row>
    <row>
      <cell>Onion, chopped</cell>
    </row>
    <row>
    <cell>3 cloves garlic</cell>
    </row>
    <row>
      <cell>2 tablespoons olive oil</cell>
    </row>
    <row>
      <cell>1 pound pasta</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cook chicken and boil pasta.
        </p>
      </li>
      <li>
        <p>
          At the same time, cook onion and garlic in olive oil.
        </p>
      </li>
      <li>
        <p>
          After onion and garlic are sufficiently cooked, add spinach.  Cook until spinach wilts.
        </p>
      </li>
      <li>
        <p>
          Add chicken and pasta.  Toss together and serve.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>