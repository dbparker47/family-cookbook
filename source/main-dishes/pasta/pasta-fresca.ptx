<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="p-fresca" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Pasta Fresca</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>4 cups chopped ripe tomatoes</cell>
    </row>
    <row>
      <cell>6 to 8 large basil leaves</cell>
    </row>
    <row>
      <cell>1 large garlic clove</cell>
    </row>
    <row>
    <cell>1 tablespoon olive oil</cell>
    </row>
    <row>
      <cell>Salt and pepper to taste</cell>
    </row>
    <row>
      <cell>1 pound bow-tie pasta</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> pound mozzarella cheese, cut into <m>\frac{1}{2}</m> inch cubes</cell>
    </row>
    <row>
      <cell>Grated parmesan cheese (optional)</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Bring a large pot of water to a rapid boil.
        </p>
      </li>
      <li>
        <p>
          In a blender or food processor, puree the tomatoes, basil, garlic, and olive oil until smooth.  Add salt and pepper to taste.
        </p>
      </li>
      <li>
        <p>
          Cook the pasta.  Drain.  Toss the pasta immediately with the cubed mozzarella cheese,  Add the sauce and mix well. Top with grated parmesan cheese.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>