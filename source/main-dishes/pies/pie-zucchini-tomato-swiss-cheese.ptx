<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="zucc-tom-swiss-pie" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Zucchini, Tomato, and Swiss Cheese Pie</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 tablespoon unsalted butter</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup bread crumbs</cell>
    </row>
    <row>
      <cell><m>1 \frac{1}{2}</m> tablespoons olive oil</cell>
    </row>
    <row>
    <cell>1 medium onion, diced</cell>
    </row>
    <row>
      <cell>2 garlic cloves, minced</cell>
    </row>
    <row>
      <cell>2 medium tomatoes, diced</cell>
    </row>
    <row>
      <cell>3 medium zucchini, quartered and sliced</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon fennel seed, crushed</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon salt (optional)</cell>
    </row>
    <row>
      <cell>black pepper (optional)</cell>
    </row>
    <row>
      <cell>3 eggs</cell>
    </row>
    <row>
      <cell><m>\frac{1}{3}</m> cup milk</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> pound swiss cheese, grated</cell>
    </row>
    <row>
      <cell>3 tablespoons parmesan cheese, grated</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Grease pie plate with <m>\frac{1}{2}</m> teaspoon butter.  Sprinkle with bread crumbs, covering the bottom and sides.
        </p>
      </li>
      <li>
        <p>
          Saute oil, onion, and garlic for 10 minutes.  Stir in tomatoes and saute for 5 more minutes.  Raise heat to high, add zucchini, fennel seed, salt, and pepper.  Cook approximately 5 minutes more. Remove from heat and cool for 5 minutes.
        </p>
      </li>
      <li>
        <p>
          Beat eggs, stir in milk, and add zucchini mixture.  Pour half of mixture into a pie plate, top with cheese, and then pour on the rest of the mixture.  Top with parmesan cheese, and dot with butter.
        </p>
      </li>
      <li>
        <p>
          Bake at <m>375^\circ</m> for 30 minutes.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>