<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="yog-bis" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Yogurt Biscuits</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 cups flour</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> teaspoon baking soda</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup canola oil</cell>
    </row>
    <row>
    <cell>3 teaspoons baking powder</cell>
    </row>
    <row>
      <cell>1 teaspoon salt</cell>
    </row>
    <row>
      <cell>1 cup plain yogurt</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          In a bowl, sift together dry ingredients. Add oil and yogurt, and mix well.
        </p>
      </li>
      <li>
        <p>
          Place dough on a board and knead until smooth.  Roll out to 1-inch thinkness and cut round biscuits using a cookie cutter (or make round balls about 2 inches in diameter).
        </p>
      </li>
      <li>
        <p>
          Place biscuits on a greased cookie sheet and bake for 10 to 12 minutes or until brown on top.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>