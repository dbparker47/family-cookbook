<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="shortbread" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Scotch Shortbread (Grandma Janet)</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 cups flour</cell>
    </row>
    <row>
      <cell>1 cup butter</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> cup powdered sugar</cell>
    </row>
    <row>
    <cell>1 cup semisweet chocolate chips (optional)</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cream butter and sugar thoroughly.  
        </p>
      </li>
      <li>
        <p>
          Add flour and sugar, mixing in quickly and lightly.  Chill dough <m>\frac{1}{2}</m> hour. 
        </p>
      </li>
      <li>
        <p>
          Roll out dough to <m>\frac{1}{2}</m> inch.  Cut as desired and place on cookie sheets and bake at <m>350^\circ</m> for 5 minutes. Reduce temperature to <m>300^\circ</m> and bake for 20 to 30 minutes longer.  Do not let them brown.
        </p>
      </li>
      <li>
        <p>
          Melt chocolate chips, either in the microwave on low power or on the stove. Spread melted chocolate on top of cookies
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>