<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="choc-chip-oat" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Chocolate Chip Oatmeal Cookies (Mrs. Fields)</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>1 cup butter</cell>
    </row>
    <row>
      <cell>1 cup brown sugar</cell>
    </row>
    <row>
      <cell>1 cup white sugar</cell>
    </row>
    <row>
    <cell>2 eggs</cell>
    </row>
    <row>
      <cell><m>\frac{1}{2}</m> teaspoon salt</cell>
    </row>
    <row>
      <cell>1 teaspoon baking powder</cell>
    </row>
    <row>
      <cell>1 teaspoon baking soda</cell>
    </row>
    <row>
      <cell>1 teaspoon vanilla</cell>
    </row>
    <row>
      <cell>2 cups flour</cell>
    </row>
    <row>
      <cell><m>2 \frac{1}{2}</m> cups oats</cell>
    </row>
    <row>
      <cell>12 ounces chocolate chips</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Cream together the butter, brown &amp; white sugars, and eggs.
        </p>
      </li>
      <li>
        <p>
          Stir in the salt, baking powder, baking soda, vanilla, and flour
        </p>
      </li>
      <li>
        <p>
          Grind the oats to a fine powder in a food processor.
        </p>
      </li>
      <li>
        <p>
          Stir the oats into the dough.  Then stir in the chocolate chips.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          Beach cookies!
        </p>
      </li>
    </ul>
  </p>
</section>