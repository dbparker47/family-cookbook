<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="bake-art" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Baked Artichoke Dip</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell>2 cups mayonnaise</cell>
    </row>
    <row>
      <cell>2 cups grated parmesan cheese</cell>
    </row>
    <row>
      <cell>28 ounces artichoke hearts</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Chop the artichoke hearts into small pieces.  Put into a baking dish.
        </p>
      </li>
      <li>
        <p>
          Mix in the mayo and cheese
        </p>
      </li>
      <li>
        <p>
          Bake at <m>350^\circ</m> until hot and bubbly (about 40 minutes).
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>