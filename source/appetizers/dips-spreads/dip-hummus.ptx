<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="humm" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Hummus</title>

  <p>
    Ingredients
  </p>
  <tabular>
    <row>
      <cell><m>2 \frac{1}{3}</m> cups garbanzo beans, cooked</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup tahini</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup sesame oil</cell>
    </row>
    <row>
    <cell><m>\frac{1}{4}</m> cup lemon juice</cell>
    </row>
    <row>
      <cell>2 cloves garlic, minced</cell>
    </row>
    <row>
      <cell>1 teaspoon Kosher salt</cell>
    </row>
    <row>
      <cell>Dash of cayenne pepper</cell>
    </row>
    <row>
      <cell><m>\frac{1}{4}</m> cup water</cell>
    </row>
  </tabular>

  <p>Instructions
    <ol>
      <li>
        <p>
          Mash it all together.
        </p>
      </li>
    </ol>
  </p>

  <p>
    Notes:
    <ul>
      <li>
        <p>
          
        </p>
      </li>
    </ul>
  </p>
</section>